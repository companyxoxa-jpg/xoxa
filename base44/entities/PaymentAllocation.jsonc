{
  "name": "PaymentAllocation",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Tenant. Must match both the payment and the fee."
    },
    "payment_id": {
      "type": "string",
      "description": "The MemberPayment this allocation belongs to."
    },
    "fee_id": {
      "type": "string",
      "description": "The MemberFee this allocation applies to."
    },
    "amount": {
      "type": "integer",
      "description": "Allocated amount in cents. Always > 0. A payment may split across several fees; a fee may receive several payments."
    }
  },
  "required": [
    "business_id",
    "payment_id",
    "fee_id",
    "amount"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
