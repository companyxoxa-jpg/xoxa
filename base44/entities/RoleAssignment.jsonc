{
  "name": "RoleAssignment",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Tenant this role assignment belongs to."
    },
    "user_id": {
      "type": "string",
      "description": "Platform user granted the role within this tenant."
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "manager",
        "staff",
        "accountant",
        "viewer"
      ],
      "description": "Association role within the tenant. Owner conserves total access."
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Granular permission strings derived from the role (members.read, members.write, memberships.manage, plans.manage, roles.manage, config.manage)."
    }
  },
  "required": [
    "business_id",
    "user_id",
    "role"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
