{
  "name": "Category",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "business_id",
    "name",
    "slug"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin",
                "email": "companyxoxa@gmail.com"
              }
            },
            {
              "user_condition": {
                "role": "admin",
                "email": "ax.network.hub@gmail.com"
              }
            },
            {
              "user_condition": {
                "role": "admin",
                "email": "xoxamariles@gmail.com"
              }
            }
          ]
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}
