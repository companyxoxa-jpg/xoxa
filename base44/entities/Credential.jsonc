{
  "name": "Credential",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Tenant (the Association Business)."
    },
    "member_id": {
      "type": "string",
      "description": "The Member this credential belongs to. At most one active credential per member."
    },
    "token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the opaque credential token. The clear token is NEVER stored — only this hash persists. Lookup at validation is by token_hash, never by clear token."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired"
      ],
      "default": "active",
      "description": "active = usable; revoked = invalidated by staff (never validates again); expired = past expires_at."
    },
    "version": {
      "type": "integer",
      "default": 1,
      "description": "Incremented on each rotation. Tracks how many tokens this credential has had."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiry. Null = no expiry (subject to membership vigency)."
    },
    "rotated_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoke_reason": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "member_id",
    "token_hash",
    "status",
    "version",
    "issued_at"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
