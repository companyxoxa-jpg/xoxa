{
  "name": "Member",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Tenant (the Association Business). Mandatory for multi-tenant isolation."
    },
    "member_number": {
      "type": "string",
      "description": "Unique member number within the tenant. Uniqueness enforced server-side (business_id + member_number); no DB-level unique index available."
    },
    "user_id": {
      "type": "string",
      "description": "Linked platform user once the portal is activated. Null until linked; a Member may exist without a User."
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Only when a module requires it (e.g. age categories). Nullable by default â€” do not collect unless needed."
    },
    "photo": {
      "type": "string",
      "description": "Avatar / credential photo URL"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended",
        "resigned",
        "expired"
      ],
      "default": "active"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string",
      "description": "Admin-only notes. NEVER exposed to the member via the portal.",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "metadata": {
      "type": "object",
      "description": "Extensible sectoral data (sport category, cultural section...). Never store PII in plain text here.",
      "additionalProperties": true
    },
    "address": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "member_number",
    "first_name",
    "last_name",
    "status"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
