{
  "name": "BookingProfessional",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "specialty": {
      "type": "string"
    },
    "photo": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "service_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "days_off": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "integer"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        },
        "required": [
          "day",
          "start",
          "end"
        ]
      }
    },
    "demo_key": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "name",
    "active"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
