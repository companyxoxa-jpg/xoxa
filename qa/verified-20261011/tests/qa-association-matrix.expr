(async()=>{const S=qaHarness.get('qa-superadmin').client,E=qaHarness.get('qa-empleado-a').client,C=qaHarness.get('qa-cliente-a').client,F=qaAssociationFixture;const A=F.ma.business_id,B=F.mb.business_id;const checks=[];const call=async(x,f,b)=>(await x.functions.invoke(f,b)).data;const add=(id,action,ok,obtained)=>checks.push({id,action,status:ok?'APROBADO':'FALLIDO',obtained});const deny=async(id,action,f)=>{try{await f();add(id,action,false,'Unexpected success');}catch(e){add(id,action,[403,404].includes(e.status),{http:e.status});}};
try{
await call(S,'ManageSupportMode',{action:'enter',business_id:B});const fee=(await call(S,'ManageMemberFee',{action:'issue',member_id:F.mb.id,fee_data:{concept:'QA synthetic fee',amount:100,due_date:'2030-01-01'}})).fee;
const payment=(await call(S,'RegisterPayment',{member_id:F.mb.id,amount:100,method:'cash',allocations:[{fee_id:fee.id,amount:100}],notes:'FICTITIOUS QA LEDGER - NO REAL MONEY',idempotency_key:'qa-security-b-20261011'})).payment;
const credential=(await call(S,'ManageCredential',{action:'issue',member_id:F.mb.id})).credential;F.payment=payment;F.credential=credential;
await deny('T22','Staff cannot register or allocate payment',()=>call(E,'RegisterPayment',{member_id:F.ma.id,amount:100,method:'cash',allocations:[{fee_id:fee.id,amount:100}]}));
await call(S,'ManageSupportMode',{action:'enter',business_id:A});await call(S,'ManageRoleAssignment',{action:'set',user_id:(await E.auth.me()).id,role:'admin'});
await deny('T23','Association admin A cannot read B member',()=>call(E,'ManageMember',{action:'get',member_id:F.mb.id}));
await deny('T23','Association admin A cannot update B member',()=>call(E,'ManageMember',{action:'update',member_id:F.mb.id,member_data:{first_name:'ILLEGAL'}}));
await deny('T23','Association admin A cannot void B payment',()=>call(E,'VoidPayment',{payment_id:payment.id}));
await deny('T23','Association admin A cannot read B credential',()=>call(E,'ManageCredential',{action:'get',credential_id:credential.id}));
await deny('T23','Association admin A cannot revoke B credential',()=>call(E,'ManageCredential',{action:'revoke',credential_id:credential.id}));
const edited=await call(E,'ManageMember',{action:'update',member_id:F.ma.id,member_data:{last_name:'QA permitted edit',internal_notes:'QA PRIVATE NOTE A updated by admin'}});add('T24','Association admin edits own member and protected notes',edited.member.last_name==='QA permitted edit'&&edited.member.internal_notes==='QA PRIVATE NOTE A updated by admin',{id:edited.member.id,business_id:edited.member.business_id});
const uid=(await E.auth.me()).id;const logs=await S.entities.AuditLog.filter({actor_user_id:uid,entity_id:F.ma.id,action:'member.data_changed'});add('T24','Edit audit attributed to real association admin',logs.length>0,{auditIds:logs.map(x=>x.id),actor:uid});
for(const entity of ['Member','RoleAssignment','AuditLog','Subscription','MemberPayment','Credential']){const rows=await C.entities[entity].list();add('T11','Customer denied direct internal '+entity,rows.length===0,{count:rows.length});}
await deny('T11','Customer cannot open internal member profile',()=>call(C,'GetMemberProfile',{member_id:F.ma.id}));
await call(S,'ManageSupportMode',{action:'enter',business_id:B});const afterM=(await call(S,'ManageMember',{action:'get',member_id:F.mb.id})).member;const afterC=(await call(S,'ManageCredential',{action:'get',credential_id:credential.id})).credential;const feeAfter=(await call(S,'ManageMemberFee',{action:'get',fee_id:fee.id})).fee;add('T23','B member, credential and paid fee remain unchanged',afterM.first_name===F.mb.first_name&&afterC.status==='active'&&feeAfter.status==='paid',{member:afterM.id,credential:afterC.id,credentialStatus:afterC.status,feeStatus:feeAfter.status});
}catch(e){checks.push({id:'FIXTURE',status:'NO VERIFICADO',http:e.status,error:e.data?.error||e.response?.data?.error||e.message});}finally{try{await call(S,'ManageSupportMode',{action:'enter',business_id:A});await call(S,'ManageRoleAssignment',{action:'set',user_id:(await E.auth.me()).id,role:'staff'});await call(S,'ManageSupportMode',{action:'exit'});}catch{}}
return{app:'6aca8950491b4b2d74f6f62d',at:new Date().toISOString(),checks};})()
