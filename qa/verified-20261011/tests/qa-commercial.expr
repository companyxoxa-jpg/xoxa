(async()=>{const C=globalThis.qaHarness.get('qa-comercial-a').client,S=globalThis.qaHarness.get('qa-superadmin').client;const a='6acb604dfa052c8f008c1dd6',b='6acb604dfa052c8f008c1dd7';const checks=[];const invoke=async(x,f,d)=>(await x.functions.invoke(f,d)).data;const put=(action,ok,obtained)=>checks.push({id:'T10',action,status:ok?'APROBADO':'FALLIDO',obtained});
const current=await invoke(C,'ManageCommercial',{action:'current'});put('Commercial authorization positive',current.role==='commercial',current);
const list=await invoke(C,'ManageSalesLead',{action:'list'});put('Assigned A visible, B hidden',list.leads.some(l=>l.id===a)&&!list.leads.some(l=>l.id===b),{ids:list.leads.map(l=>l.id)});
const updated=await invoke(C,'ManageSalesLead',{action:'update',id:a,status:'contacted',internal_notes:'QA permitted update'});put('Assigned lead writable',updated.lead?.status==='contacted',{id:updated.lead?.id});
for(const [action,fn,payload] of [['Foreign lead update','ManageSalesLead',{action:'update',id:b,status:'closed'}],['Self assignment of B','ManageSalesLead',{action:'assign',id:b,assigned_to:'qa-comercial-a@rinno.es'}],['Foreign business update','UpdateBusinessConfig',{business_id:'6aca8bffd29ed0095f3ea683',business_name:'ILLEGAL'}],['Foreign billing read','ManageBilling',{action:'summary',business_id:'6aca8bffd29ed0095f3ea683'}]]){try{await invoke(C,fn,payload);put(action,false,'Unexpected success');}catch(e){put(action,e.status===403,{http:e.status});}}
const final=await invoke(S,'ManageSalesLead',{action:'list'});put('Foreign lead unchanged',final.leads.find(l=>l.id===b)?.status==='new',{status:final.leads.find(l=>l.id===b)?.status});
return{app:'6aca8950491b4b2d74f6f62d',at:new Date().toISOString(),checks};})()
