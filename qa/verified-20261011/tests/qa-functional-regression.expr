(async()=>{const S=qaHarness.get('qa-superadmin').client,C=qaHarness.get('qa-cliente-a').client,D=qaHarness.get('qa-cliente-b').client,E=qaHarness.get('qa-empleado-a').client;const A='6aca8bffd29ed0095f3ea682';const checks=[];const call=async(x,f,b)=>(await x.functions.invoke(f,b)).data;
async function check(area,run){try{const r=await run();checks.push({id:'T26',area,status:r.ok?'APROBADO':'FALLIDO',obtained:r});}catch(e){checks.push({id:'T26',area,status:'FALLIDO',http:e.status,error:e.data?.error||e.response?.data?.error||e.message});}}
await call(S,'ManageSupportMode',{action:'enter',business_id:A});
await check('Store catalog, legitimate order, cross-customer denial',async()=>{await call(S,'ManageProduct',{action:'update',product_id:'6acb506c8a5632ab7b03bf9b',product_data:{status:'active',is_available:true,price:100,minimum_quantity:1,quantity_step:1}});const catalog=await call(C,'GetStorefront',{slug:'rinno-qa-a-20261010'});const order=await call(C,'CreateOrder',{slug:'rinno-qa-a-20261010',items:[{product_id:'6acb506c8a5632ab7b03bf9b',quantity:1}],fulfillment_type:'pickup',scheduled_date:'2026-10-12',scheduled_time_start:'12:00',scheduled_time_end:'13:00',customer:{first_name:'Cliente ficticio QA',phone:'000000000',email:'qa-cliente-a@rinno.es'},payment_method:'cash_on_delivery'});const detail=await call(C,'GetCustomerOrderDetail',{slug:'rinno-qa-a-20261010',order_id:order.order_id});let foreignDenied=false;try{await call(D,'GetCustomerOrderDetail',{slug:'rinno-qa-a-20261010',order_id:order.order_id});}catch(e){foreignDenied=e.status===404;}return{ok:!!catalog&&detail.order.id===order.order_id&&foreignDenied,order_id:order.order_id,total:order.total,foreignDenied,payment:'Fictitious unpaid cash-on-delivery order, no funds moved'};});
await check('Booking create, list, confirm, cross-customer denial and own cancellation',async()=>{const service=await call(S,'ManageBooking',{action:'save_service',data:{name:'QA servicio ficticio',active:true,price:100,duration_minutes:30}});const professional=await call(S,'ManageBooking',{action:'save_professional',data:{name:'QA profesional ficticio',active:true,service_ids:[service.id],schedule:[{day:1,start:'09:00',end:'18:00'}],days_off:[]}});const request={slug:'rinno-qa-a-20261010',service_id:service.id,professional_id:professional.id,date:'2026-10-12'};const availability=await call(C,'BookingPublic',{...request,action:'availability'});if(!availability.slots.length)return{ok:false,reason:'No available slot'};const booking=await call(C,'BookingPublic',{...request,action:'reserve',time:availability.slots[0].time,request_id:'qa-security-booking-20261011',customer_name:'Cliente ficticio QA',phone:'000000000',privacy_accepted:true});const listed=await call(C,'CustomerAppointments',{action:'list'});await call(E,'ManageBooking',{action:'status',id:booking.appointment.id,status:'confirmed'});let foreignDenied=false;try{await call(D,'CustomerAppointments',{action:'cancel',id:booking.appointment.id});}catch(e){foreignDenied=e.status===404;}await call(C,'CustomerAppointments',{action:'cancel',id:booking.appointment.id});return{ok:listed.appointments.some(x=>x.id===booking.appointment.id)&&foreignDenied,appointment_id:booking.appointment.id,foreignDenied};});
await check('Contract draft create, save, read and customer denial (unsigned)',async()=>{const data={client_name:'QA Empresa Ficticia',trade_name:'QA Comercio Ficticio',tax_id:'QA-NO-VALIDO',representative_name:'Persona Ficticia',representative_id:'QA-NO-VALIDO',contact_email:'qa-cliente-a@rinno.es',contact_phone:'000000000',payment_method:'stripe'};const draft=await call(S,'ManageContract',{action:'create',data});await call(S,'ManageContract',{action:'save',id:draft.contract.id,data:{...data,trade_name:'QA Borrador Editado'}});const detail=await call(S,'ManageContract',{action:'get',id:draft.contract.id});let denied=false;try{await call(C,'ManageContract',{action:'get',id:draft.contract.id});}catch(e){denied=e.status===403;}return{ok:detail.contract.trade_name==='QA Borrador Editado'&&denied,contract_id:draft.contract.id,status:detail.contract.status,customerDenied:denied,signed:false};});
await check('Association legitimate profile and own billing summary',async()=>{const profile=await call(S,'GetMemberProfile',{member_id:qaAssociationFixture.ma.id});const billing=await call(S,'ManageBilling',{action:'summary',business_id:A});return{ok:profile.member.id===qaAssociationFixture.ma.id&&billing.subscription?.business_id===A,member_id:profile.member.id,subscription_id:billing.subscription?.id};});
await call(S,'ManageSupportMode',{action:'exit'});
await check('New isolated QA demo installation and public booking catalog',async()=>{const demo=await call(S,'InstallDemo',{template_id:'beauty-spa'});const catalog=await call(C,'BookingPublic',{action:'catalog',slug:demo.slug});return{ok:!!demo.business_id&&catalog.services?.length>0,business_id:demo.business_id,slug:demo.slug,services:catalog.services?.length,professionals:catalog.professionals?.length};});
return {app:'6aca8950491b4b2d74f6f62d',at:new Date().toISOString(),scope:'Hosted backend functional regression; real verified user sessions. Unsigned contract draft, unpaid synthetic order, no real charge. Not visual QA of full storefront or full Stripe checkout lifecycle.',checks};})()
