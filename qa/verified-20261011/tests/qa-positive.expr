(async()=>{const c=n=>globalThis.qaHarness.get(n).client;const S=c('qa-superadmin'),C=c('qa-cliente-a'),E=c('qa-empleado-a');const A='6aca8bffd29ed0095f3ea682',B='6aca8bffd29ed0095f3ea683';const checks=[];const invoke=async(x,f,b)=>(await x.functions.invoke(f,b)).data;
async function check(id,action,f){try{const obtained=await f();checks.push({id,action,status:obtained.ok?'APROBADO':'FALLIDO',obtained});}catch(e){checks.push({id,action,status:'NO VERIFICADO',http:e.status,error:e.data?.error||e.message});}}
await check('T25','Super Admin enters and exits QA support; attributed audit',async()=>{const entered=await invoke(S,'ManageSupportMode',{action:'enter',business_id:A});const during=await S.auth.me();const exited=await invoke(S,'ManageSupportMode',{action:'exit'});const after=await S.auth.me();const logs=await S.entities.AuditLog.filter({actor_user_id:after.id,business_id:A});return {ok:entered.ok&&exited.ok&&during.support_business_id===A&&!after.support_business_id&&logs.some(l=>l.action==='support.entered')&&logs.some(l=>l.action==='support.exited'),actor:after.id,trace:logs.map(l=>({id:l.id,action:l.action,actor_user_id:l.actor_user_id}))};});
await check('T16','Create legitimate own address and reject direct tenant reassignment',async()=>{const r=await invoke(C,'ManageSavedAddress',{action:'create',slug:'rinno-qa-a-20261010',address_data:{address:'Calle ficticia QA 42',city:'Ciudad ficticia'}});globalThis.qaAddressFixture=r.address;const attempts=[];for(const business_id of [B,null,'']){try{await C.entities.SavedAddress.update(r.address.id,{business_id});attempts.push({denied:false});}catch(e){attempts.push({denied:e.status===403,http:e.status});}}const after=await C.entities.SavedAddress.get(r.address.id);return{ok:after.business_id===A&&attempts.every(a=>a.denied),id:r.address.id,business_id:after.business_id,attempts};});
await check('T22','Employee cannot assign owner role',async()=>{try{await invoke(E,'ManageRoleAssignment',{action:'set',user_id:(await E.auth.me()).id,role:'owner'});return{ok:false};}catch(e){return{ok:e.status===403,http:e.status,error:e.data?.error}}});
await check('SETUP-CLOSED','No provisioning privilege endpoint remains',async()=>{try{await invoke(E,'QaProvisionVerifiedRoles',{});return{ok:false};}catch(e){return{ok:e.status===410,http:e.status}}});
return {app:'6aca8950491b4b2d74f6f62d',at:new Date().toISOString(),checks};})()
